# Copy to .env and fill in real values. Never commit .env itself.
# All services below have a free tier or run fully locally — see AGENTS.md
# "Tech stack" section before adding any paid key.

# LLM provider — OpenRouter or local Ollama. Fill in whichever you're using;
# leave the others blank. Ollama needs no key, just OLLAMA_BASE_URL.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL=
# Comma-separated fallback model IDs in priority order (2-3 models).
OPENROUTER_MODELS=
OPENROUTER_REQUESTS_PER_MINUTE=20
OLLAMA_BASE_URL=http://localhost:11434

# Memory backend — local/free by default
REDIS_URL=redis://localhost:6379
CHROMA_PERSIST_DIR=./chroma_data

# Docker sandbox
DOCKER_SANDBOX_IMAGE=

# Observability
LOG_LEVEL=info
