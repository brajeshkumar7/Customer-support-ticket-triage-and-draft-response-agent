# Copy to .env and fill in real values. Never commit .env itself.
# All services below have a free tier or run fully locally — see AGENTS.md
# "Tech stack" section before adding any paid key.

# LLM provider — OpenRouter or local Ollama. Fill in whichever you're using;
# leave the others blank. Ollama needs no key, just OLLAMA_BASE_URL.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL=
# Comma-separated fallback model IDs in priority order (2-3 models).
OPENROUTER_MODELS=
OPENROUTER_REQUESTS_PER_MINUTE=20
OLLAMA_BASE_URL=http://localhost:11434

# Memory backend — local/free by default
REDIS_URL=redis://localhost:6379
CHROMA_PERSIST_DIR=./chroma_data

# Docker sandbox
DOCKER_SANDBOX_IMAGE=

# Observability
LOG_LEVEL=info

# Zoho Desk public email replies (disabled unless explicitly enabled).
# Set both domains to the domains returned/used for your Zoho data center.
ZOHO_DESK_SEND_ENABLED=false
ZOHO_DESK_API_DOMAIN=https://desk.zoho.in
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
ZOHO_DESK_ORG_ID=60089176605
ZOHO_DESK_FROM_EMAIL=support@ssngroup.zohodesk.in
ZOHO_CLIENT_ID=1000.OO0A64POKDXN9HLE5OMCPFZ6A9QCZZ
ZOHO_CLIENT_SECRET=87677965efad7536b4d46ccb7da31d262113e3128b
ZOHO_REFRESH_TOKEN=1000.3b57a3661f0a85311281212bc73f14c5.a6f27a38f0fc1dea1f3fbbf31e4a4c95
