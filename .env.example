# Copy to .env and fill in real values. Never commit .env itself.
# Local development can use free/local services. The optional Render worker
# and PostgreSQL deployment are paid; see docs/controlled_render.md.

# LLM provider — OpenRouter or local Ollama. Fill in whichever you're using;
# leave the others blank. Ollama needs no key, just OLLAMA_BASE_URL.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL=
# Comma-separated fallback model IDs in priority order (2-3 models).
OPENROUTER_MODELS=
OPENROUTER_REQUESTS_PER_MINUTE=20
OPENROUTER_TIMEOUT_SECONDS=20
AGENT_RUN_TIMEOUT_SECONDS=60
OLLAMA_BASE_URL=http://localhost:11434

# Memory backend — local/free by default
REDIS_URL=redis://localhost:6379
CHROMA_PERSIST_DIR=./chroma_data

# Docker sandbox
DOCKER_SANDBOX_IMAGE=

# Observability
LOG_LEVEL=info

# Legacy controlled smoke/fake-sender flag. The production worker ignores it;
# DEPLOYMENT_MODE, approved knowledge, database allowlist and kill switch gate sends.
# Set both domains to the domains returned/used for your Zoho data center.
ZOHO_DESK_SEND_ENABLED=false
ZOHO_DESK_API_DOMAIN=https://desk.zoho.in
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
ZOHO_DESK_ORG_ID=
ZOHO_DESK_FROM_EMAIL=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Controlled Render worker. Defaults to off. Live mode fails startup until
# authoritative business providers and release evidence are available.
DEPLOYMENT_MODE=off
DATABASE_URL=
# SHA-256 of owner-approved data/approved_knowledge/v1.json. Empty blocks test sends.
APPROVED_KNOWLEDGE_SHA256=
